&GLOBAL
	PRINT_LEVEL MEDIUM
	PROJECT_NAME H2
	RUN_TYPE RT_PROPAGATION
&END GLOBAL

&MOTION
	&MD
		TIMESTEP [fs] 0.005
		STEPS 50
	&END MD
&END MOTION

&FORCE_EVAL
	&SUBSYS
		&CELL
			ABC [angstrom] 10.0 10.0 10.0
			PERIODIC XYZ
		&END CELL
		&COORD
			H 5.0 5.0 5.0
			H 5.741 5.0 5.0
		&END COORD
		&KIND H
			POTENTIAL GTH-PBE
			BASIS_SET ORB SZV-MOLOPT-GTH
			BASIS_SET RI_AUX RI_18_2_2_2_0_0_0_0_4.3e-04
		&END KIND
	&END SUBSYS
	&DFT
		BASIS_SET_FILE_NAME BASIS_MOLOPT
		BASIS_SET_FILE_NAME BASIS_RI_MOLOPT
		POTENTIAL_FILE_NAME GTH_POTENTIALS
		&QS
			METHOD GPW
			EPS_DEFAULT 1.0e-12
			EPS_PGF_ORB 1.0e-6
		&END QS
		&XC
			&XC_FUNCTIONAL PBE
			&END XC_FUNCTIONAL
		&END XC
		&MGRID
			CUTOFF [eV] 2000.0
			REL_CUTOFF [eV] 200.0
			NGRIDS 4
		&END MGRID
		&KPOINTS
			SCHEME MONKHORST-PACK 1 1 1
			VERBOSE
			SYMMETRY .FALSE.
			FULL_GRID .TRUE.
		&END KPOINTS
		&POISSON
			PERIODIC XYZ
			POISSON_SOLVER PERIODIC
		&END POISSON
		&SCF
			EPS_SCF 1.0e-8
			MAX_SCF 50
			SCF_GUESS ATOMIC
			&DIAGONALIZATION
				ALGORITHM STANDARD
			&END DIAGONALIZATION
			&MIXING
				METHOD BROYDEN_MIXING
				NBROYDEN 6
				ALPHA 0.4
			&END MIXING
		&END SCF
		&REAL_TIME_PROPAGATION
			&SBE
				DEPHASING_TIME 0.0
				PROPAGATOR RK4
			&END SBE
			&PRINT
				&OCCUPATIONS_MO
					FILENAME __STD_OUT__
				&END OCCUPATIONS_MO
			&END PRINT
			MAT_EXP BCH
		&END REAL_TIME_PROPAGATION
		&EFIELD
			ENVELOP GAUSSIAN
			AMPLITUDE [Vnm-1] 1e-3
			POLARISATION 1 0 0
			WAVELENGTH [nm] 1e10
			&GAUSSIAN_ENV
				SIGMA [fs] 0.020
				T0 [fs] 0.080
			&END GAUSSIAN_ENV
		&END EFIELD
	&END DFT
&END FORCE_EVAL
