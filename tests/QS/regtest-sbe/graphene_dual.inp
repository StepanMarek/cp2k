&GLOBAL
	PRINT_LEVEL MEDIUM
	PROJECT_NAME GRAPHENE
	RUN_TYPE RT_PROPAGATION
&END GLOBAL

&MOTION
	&MD
		TIMESTEP [fs] 0.002
		STEPS 100
		! Reach 600 fs, i.e. 3 T0
		! STEPS 30000
	&END MD
&END MOTION

&FORCE_EVAL
	&SUBSYS
		&CELL
			A [angstrom] 2.4672312604313453 0.0 0.0
			B [angstrom] -1.233615630215672 2.1366849485446453 0.0
			! Last direction is a convergence parameter
			C [angstrom] 0.0 0.0 15.0
			PERIODIC XY
		&END CELL
		! Adapted from c2db https://c2db.fysik.dtu.dk/material/2C-1
		&COORD
			C 0.0 0.0 7.5
			C 1.23361563 0.71222832 7.5
		&END COORD
		&KIND C
			BASIS_SET SZV-MOLOPT-GTH
			POTENTIAL GTH-PBE
		&END KIND
	&END SUBSYS
	&DFT
		BASIS_SET_FILE_NAME BASIS_MOLOPT
		POTENTIAL_FILE_NAME GTH_POTENTIALS
		&QS
			METHOD GPW
			EPS_DEFAULT 1.0e-12
		&END QS
		&XC
			&XC_FUNCTIONAL PBE
			&END XC_FUNCTIONAL
		&END XC
		&MGRID
			CUTOFF [eV] 3000.0
			REL_CUTOFF [eV] 300.0
			NGRIDS 4
		&END MGRID
		&KPOINTS
			SCHEME MONKHORST-PACK 16 16 1
			VERBOSE
		&END KPOINTS
		&POISSON
			PERIODIC XY
			POISSON_SOLVER ANALYTIC
		&END POISSON
		&SCF
			EPS_SCF 1.0e-8
			MAX_SCF 50
			SCF_GUESS RESTART
			&DIAGONALIZATION
				ALGORITHM STANDARD
			&END DIAGONALIZATION
			&MIXING
				METHOD BROYDEN_MIXING
				NBROYDEN 6
				ALPHA 0.4
			&END MIXING
		&END SCF
		&PRINT
			&BAND_STRUCTURE
				ADDED_MOS 4
				FILE_NAME graphene.bs
				&KPOINT_SET
					NPOINTS 100
					SPECIAL_POINT GAMMA 0.0 0.0 0.0
					SPECIAL_POINT K 0.333333 0.333333 0.0
					SPECIAL_POINT M 0.0 0.5 0.0
					SPECIAL_POINT GAMMA 0.0 0.0 0.0
				&END KPOINT_SET
			&END BAND_STRUCTURE
		&END PRINT
		&REAL_TIME_PROPAGATION
			&SBE
				PROPAGATOR RK4
				DEPHASING_TIME [fs] 100.0
				&KPOINTS
					SCHEME SET+MP
					GRID 4 4 1
					&KPOINT_SET
						NPOINTS 3
						SPECIAL_POINT 0.0 0.0 0.0
						SPECIAL_POINT 1/3 1/3 0.0
					&END KPOINT_SET
				&END KPOINTS
			&END SBE
			&PRINT
				&OCCUPATIONS_MO
					FILENAME __STD_OUT__
				&END OCCUPATIONS_MO
				&OCCUPATIONS_KP
					FILENAME __STD_OUT__
				&END OCCUPATIONS_KP
			&END PRINT
		&END REAL_TIME_PROPAGATION
		&EFIELD
			ENVELOP GAUSSIAN
			POLARISATION 1 0 0
			AMPLITUDE [Vnm-1] 0.001
			WAVELENGTH [nm] 1e5
			&GAUSSIAN_ENV
				T0 [fs] 0.080
				SIGMA [fs] 0.020
			&END GAUSSIAN_ENV
		&END EFIELD
	&END DFT
&END FORCE_EVAL
